{
  "name": "paris-sportif",
  "version": "1.2.3",
  "description": "Logiciel PC local de prédictions Paris-Sportif.",
  "private": true,
  "scripts": {
    "desktop": "npm --prefix desktop start",
    "test": "npm run qa:unit && npm run qa:refresh && node desktop/scripts/smoke.js",
    "qa:desktop": "node desktop/scripts/smoke.js",
    "qa:visual": "node desktop/scripts/visual-capture.js",
    "qa:stress": "node desktop/scripts/stress-check.js",
    "qa:a11y": "node desktop/scripts/a11y-check.js",
    "qa:multiday": "node desktop/scripts/multi-day-check.js",
    "qa:unit": "node scripts/qa_unit_runner.js",
    "qa:refresh": "node desktop/scripts/refresh-contract.js",
    "qa:engine": "node desktop/scripts/engine-contract.js",
    "qa:terrain": "node desktop/scripts/terrain-check.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "playwright": "^1.48.0"
  }
}
