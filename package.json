{
  "name": "paris-sportif",
  "version": "8.6.23",
  "description": "Logiciel PC local de prédictions Paris-Sportif.",
  "private": true,
  "scripts": {
    "desktop": "npm --prefix desktop start",
    "test": "npm run qa:fast",
    "qa:fast": "npm run qa:unit && npm run qa:refresh && npm run qa:desktop:fast",
    "qa:desktop": "npm run qa:desktop:fast",
    "qa:desktop:fast": "node desktop/scripts/smoke-fast.js",
    "qa:desktop:full": "node desktop/scripts/smoke.js",
    "qa:visual-capture-png": "node desktop/scripts/visual-capture.js",
    "qa:stress": "node desktop/scripts/stress-check.js",
    "qa:a11y": "node desktop/scripts/a11y-check.js",
    "qa:multiday": "node desktop/scripts/multi-day-check.js",
    "qa:unit": "node scripts/qa_unit_runner.js",
    "qa:refresh": "node desktop/scripts/refresh-contract.js",
    "qa:engine": "node desktop/scripts/engine-contract.js",
    "qa:safe": "node desktop/scripts/safe-assessment-check.js",
    "qa:calibration": "node desktop/scripts/calibration-check.js",
    "qa:visual": "node desktop/scripts/visual-baseline.js",
    "qa:visual-capture": "node desktop/scripts/visual-baseline.js capture",
    "qa:terrain": "node desktop/scripts/terrain-check.js",
    "qa:terrain:quick": "node desktop/scripts/terrain-check.js --skip-refresh",
    "qa:winamax-audit": "node desktop/scripts/winamax-audit.js",
    "qa:clean": "node scripts/qa_clean_workspace.js",
    "qa:ui-inventory": "node scripts/ui_inventory.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "playwright": "^1.48.0"
  }
}
