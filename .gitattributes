# Force LF endings for all text files. The repo's local git config has
# `core.autocrlf=false` while the global is `true`, so contributors on
# Windows otherwise get CRLF in working tree → giant phantom diffs whenever
# auto_refresh.py rewrites pronostics.html/data.js. This file removes that
# entire class of bug.
* text=auto eol=lf

# Windows launchers must stay CRLF. cmd.exe can misread LF-only .bat files
# and silently block when launched through wscript.
*.bat text eol=crlf
*.cmd text eol=crlf
*.vbs text eol=crlf

# Binary lockdown : never normalize EOL on these
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.woff binary
*.woff2 binary
